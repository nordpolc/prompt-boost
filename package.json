{
  "name": "@local/prompt-boost",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "Adds a persona-aware enhance-prompt button to the composer tool row (with editable author context) and one-click revert to the draft it replaced.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./personas": "./personas.js"
  },
  "files": [
    "index.js",
    "client.js",
    "personas.js",
    "workspace.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "install.sh"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "prompt",
    "prompt-enhance",
    "persona",
    "composer"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nordpolc/prompt-boost.git"
  },
  "homepage": "https://github.com/nordpolc/prompt-boost#readme",
  "scripts": {
    "smoke": "node .smoke.mjs"
  }
}
