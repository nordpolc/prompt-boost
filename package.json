{
  "name": "@local/prompt-boost",
  "version": "1.3.0",
  "private": true,
  "type": "module",
  "description": "Adds a persona-aware enhance-prompt button to the composer tool row (with editable author context) and one-click revert to the draft it replaced.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./personas": "./personas.js"
  },
  "files": [
    "index.js",
    "client.js",
    "personas.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
